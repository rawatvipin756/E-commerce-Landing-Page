        function econstoreval() {
            var valid = true;
            var mobile = $('input[name="e_contact_phone"]').val();
            //alert(mobile);
            $(".error").remove();

            if (mobile.length < 1) {
                $('input[name="e_contact_phone"]').after('<span class="error">This field is required</span>').focus();
                return false;
            }
            if (isNaN(mobile) || mobile.indexOf(" ") != -1) {
                $('input[name="e_contact_phone"]').after('<span class="error">Invalid Mobile No.</span>').focus();
                return false;
            }
            if (mobile.length > 10 || mobile.length < 10) {
                $('input[name="e_contact_phone"]').after('<span class="error">Mobile No. should be 10 digit</span>')
                    .focus();
                return false;
            }
            if (!(mobile.charAt(0) == "6" || mobile.charAt(0) == "7" || mobile.charAt(0) == "8" || mobile.charAt(0) ==
                    "9")) {
                $('input[name="e_contact_phone"]').after(
                    '<span class="error">Mobile No. should start with 6,7,8 and 9</span>').focus();
                return false
            }

            //alert(valid);
            return valid;
        }


