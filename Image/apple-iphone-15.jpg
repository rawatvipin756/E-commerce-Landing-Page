    navbar.style.top = "0px";
  }
  lastScroll = currentScroll;*/
  
});

//custom-select-dropdown
document.querySelectorAll(".custom-select, .custom-select-md").forEach(select => {
    
    const trigger = select.querySelector(".trigger");
    const selectedSpan = select.querySelector(".selected");
    const icon = select.querySelector(".fi");
    const searchInput = select.querySelector("input[type='text']");
    const listItems = select.querySelectorAll(".options ul li");
    const list = select.querySelector(".options ul");
    let noResultItem = null;

    // Open / Close dropdown
    trigger.addEventListener("click", () => {
        closeAllDropdowns(select);
        select.classList.toggle("open");
        icon.classList.toggle("rotate-up");
        icon.classList.toggle("rotate-down");
    });

    // On option click
    listItems.forEach(option => {
        option.addEventListener("click", () => {
            selectedSpan.textContent = option.textContent;

            listItems.forEach(o => o.classList.remove("selected"));
            option.classList.add("selected");

            closeSelect(select, icon, searchInput, listItems, noResultItem);
        });
    });

    // Search Filter
    searchInput.addEventListener("keyup", () => {
        const value = searchInput.value.toLowerCase();
        let foundMatch = false;

        if (noResultItem) {
            noResultItem.remove();
            noResultItem = null;
        }

        listItems.forEach(li => {
            const text = li.textContent.toLowerCase();
            li.style.display = text.includes(value) ? "block" : "none";
            if (text.includes(value)) foundMatch = true;
        });

        if (!foundMatch) {
            noResultItem = document.createElement("li");
            noResultItem.textContent = "NO RESULT";
            noResultItem.style.fontWeight = "400";
            noResultItem.style.color = "var(--primary-color)";
            noResultItem.style.cursor = "default";
            list.appendChild(noResultItem);
        }
    });
});

// Close dropdown when clicking outside
document.addEventListener("click", (e) => {
    document.querySelectorAll(".custom-select, .custom-select-md").forEach(select => {
        if (!select.contains(e.target)) {
            const icon = select.querySelector(".fi");
            const searchInput = select.querySelector("input");
            const listItems = select.querySelectorAll("ul li");
            closeSelect(select, icon, searchInput, listItems);
        }
    });
});

// Utility Functions
function closeSelect(select, icon, searchInput, listItems, noResultItem) {
    select.classList.remove("open");
    icon.classList.remove("rotate-up");
    icon.classList.add("rotate-down");
    if (searchInput) searchInput.value = "";
    if (listItems) listItems.forEach(li => li.style.display = "block");
    if (noResultItem) noResultItem.remove();
}

function closeAllDropdowns(current) {
    document.querySelectorAll(".custom-select, .custom-select-md").forEach(select => {
        if (select !== current) {
            const icon = select.querySelector(".fi");
            const searchInput = select.querySelector("input");
            const listItems = select.querySelectorAll("ul li");
            closeSelect(select, icon, searchInput, listItems);
        }
    });
}


