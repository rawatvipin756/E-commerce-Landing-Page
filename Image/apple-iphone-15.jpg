//snow-fall-effect
document.addEventListener('DOMContentLoaded', function () {

  const layers = [
  {
    selector: '.snow.blurred',
    count: 15,
    size: [20, 30],
    speed: [16, 22],
    sway: [20, 50],
    char: '•',
    color: 'rgba(201, 201, 201, 1)'   // light gray
  },
  {
    selector: '.snow.clear',
    count: 15,
    size: [15, 20],
    speed: [12, 18],
    sway: [30, 100],
    char: '❄',
    color: 'rgba(174, 202, 211, 1)'  // medium white
  },
  {
    selector: '.snow.very-clear',
    count: 20,
    size: [20, 30],
    speed: [8, 14],
    sway: [30, 100],
    char: '❄',
    color: '#5ca4acff'  // bright blue
  }
];

  const rand = (min, max) => Math.random() * (max - min) + min;

  function createFlake(layer) {
  const wrap = document.createElement('span');
  wrap.className = 'flake-wrap';

  const flake = document.createElement('span');
  flake.className = 'flake';
  flake.textContent = layer.char;

  /* ✅ APPLY COLOR */
  flake.style.color = layer.color;

  const left = rand(0, window.innerWidth);
  const size = rand(layer.size[0], layer.size[1]);
  const duration = rand(layer.speed[0], layer.speed[1]);
  const delay = rand(-duration, 0);

  wrap.style.left = left + 'px';
  wrap.style.animationDuration = duration + 's';
  wrap.style.animationDelay = delay + 's';

  flake.style.fontSize = size + 'px';
  flake.style.animationDuration = Math.max(4, duration / 2) + 's';
  flake.style.setProperty('--sway', rand(-layer.sway[1], layer.sway[1]) + 'px');
  flake.style.setProperty('--rot', rand(120, 360) + 'deg');
  flake.style.opacity = rand(0.6, 1);

  wrap.appendChild(flake);
  return wrap;
}

  layers.forEach(layer => {
    const container = document.querySelector(layer.selector);
    if (!container) return;

    for (let i = 0; i < layer.count; i++) {
      container.appendChild(createFlake(layer));
    }
  });

});


