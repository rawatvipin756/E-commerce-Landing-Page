// newly add mobile menu at 26/12/2025 start
//mobile-navigation-css
const mainmenu = document.querySelectorAll('.main-menu-new');

function openMenu(menu) {
  menu.classList.remove("hidden");
  menu.classList.add("show");

  // animate open
  menu.style.maxHeight = menu.scrollHeight + "px";

  // 🔥 release height AFTER animation
  menu.addEventListener("transitionend",() => {
      if (menu.classList.contains("show")) {
        menu.style.maxHeight = "none";
      }
    },{ once: true }
  );
}

function closeMenu(menu) {
  // lock current height before collapsing
  menu.style.maxHeight = menu.scrollHeight + "px";

  requestAnimationFrame(() => {
    menu.style.maxHeight = "0px";
    menu.classList.remove("show");
    menu.classList.add("hidden");
  });
}

mainmenu.forEach((item) => {
  const triggerbutton = item.querySelector('div');
  const submenu = item.querySelector('.sidebar-sub-menu');
  const plusminusicon = triggerbutton.querySelector('.fi');

  triggerbutton.addEventListener('click', (e) => {
    e.stopPropagation();

    if (submenu.classList.contains("show")) {
      closeMenu(submenu);
    } else {
      openMenu(submenu);
    }

    plusminusicon.classList.toggle("fi-bs-plus");
    plusminusicon.classList.toggle("fi-bs-minus");
  });
});

/* Outside click close */
document.addEventListener('click', () => {
  mainmenu.forEach((item) => {
    const submenu = item.querySelector('.sidebar-sub-menu');
    const icon = item.querySelector('.fi');

    if (submenu.classList.contains("show")) {
      closeMenu(submenu);
      icon.classList.add("fi-bs-plus");
      icon.classList.remove("fi-bs-minus");
    }
  });
});
