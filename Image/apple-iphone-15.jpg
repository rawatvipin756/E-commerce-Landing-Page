}
.sidebar-sub-menu{
    transition: max-height 0.4s ease, opacity 0.3s ease, transform 0.3s ease;
}
.sidebar-sub-menu.hidden{
    transform: translateY(-20px);
    opacity: 0;
    max-height: 0px;
    visibility: hidden;
}
.sidebar-sub-menu.show{
    transform: translateY(0%);
    opacity: 1;
    max-height: fit-content;
    visibility: visible;
} */
.logo{
    /*margin-left: 15px;
    margin-right: auto;
    transform: translateY(10px);*/
}
.santa-hat{
    top: -25px;
    left: 53%;
    animation: updown 2s ease-in-out infinite;
}
.santa-hat-img{
    width: 45px;
    filter: brightness(1.2);
    animation: skew 2s ease-in-out infinite;
}
@keyframes updown{
    0%,100%{
        transform: translate(-50%, 0px);
    }
    50%{
        transform: translate(-50%, -2.5px);
    }
}
@keyframes skew{
    0%,100%{
        transform: skewY(0deg);
    }
    33.3%{
        transform: skewY(5deg);
    }
    66.6%{
        transform: skewY(-5deg);
    }
}
.account-icon{
    position: relative;
    cursor: pointer;
}
.account-links-div{
    display: none !important;
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: 10px;
}
.account-links{
    background-color: white;
    padding: 5px !important;
    box-shadow: 0px 0px 5px #b3b3b3;
    border-radius: 5px;
    z-index: 999;
}
.account-icon:hover .account-links-div, .account-icon:focus .account-links-div{
    display: flex !important;
}
.inputs{
    flex: 1;
    align-items: center;
    height: 44px;
    border: 2px #b3b3b3 solid;
    border-radius: 5px;
    background-color: white;
    /*margin: 0px 20px;*/
    max-width: 720px;
}
.search-button{
    height: 100%;
    border: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    right: -2px;

}
.log-button:hover{
    color: var(--primary-color) !important;
    text-decoration: underline;
}
.notifications{
    transform: translate(-50%, -35%);
}
.main-buttons{
    column-gap: 15px;
}
@media(max-width:576px){
    .main-buttons{
        column-gap: 15px;
    }
    .logo{
        margin-left: 0px;
    }
    .menu-buttons{
        margin-right: 0px !important;
    }
    .counts-md{
        flex-direction: column !important;
    }
}
.menu-buttons{
    margin-right: 15px;
}
.custom-select {
    position: relative;
    width: max-content;
}
.custom-select-md {
    position: relative;
    width: 100px;
    padding-right: 10px;
    border-right: 2px solid #b3b3b3;
}
.custom-select-md .trigger{
    padding: 0px 0px 0px 10px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
    border: 0;
}
.trigger {
    padding: 0px 10px 0px 5px;
    column-gap: 5px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-right: 2px #b3b3b3 solid;
}
.options{
    border: 1px solid #ccc;
    position: absolute;
    top: 140%;
    width: 100%;
    display: none;
    z-index: 10;
}
.options div{
    padding: 5px;
    width: 100%;
    border-bottom: 1.5px solid #b3b3b3;
}
.options div input{
    height: 30px;
    border-radius: 0px;
    border: 1px solid #b3b3b3;
    outline: none;
    padding: 2px 10px;
    width: 100%;
}
.options ul{
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    height: 200px;
    overflow-y: auto;
}
/*.options::-webkit-scrollbar{
    width: 10px;
}
.options::-webkit-scrollbar-track{
    background: var(--primary-color);
}
.options::-webkit-scrollbar-thumb{
    background: #f9ec25;
    border: 3px solid var(--primary-color);
    border-radius: 20px;
}*/
.custom-select.open .options, .custom-select-md.open .options {
    display: block;
    width: max-content;
}
.options li {
    padding:5px 10px;
    cursor: pointer;
    transition: 0.2s;
    display:flex;
}
/* Hover color */
.options li:hover {
    background: var(--primary-color);
    color: white;
}
/* Selected option color (static) */
.options li.selected {
    background: #f2f2f2;     /* your color */
    color: #000000;             /* text color */
}
.rotate-up{
    transform: rotate(180deg);
    transition: all 0.3s ease-in-out;
}
.rotate-down{
    transform: rotate(0deg);
    transition: all 0.3s ease-in-out;
}
.deal-countdown{
    row-gap: 5px;
}
.deal-countdown-md{
    display: none;
    justify-content: space-evenly;
    align-items: center;
    padding-top: 5px;
}
.deals{
    animation: gradientinfinite 5s linear infinite alternate both;
    background-image: linear-gradient(45deg, #ff4545, #d6c100, #02b7ff, #ff4545, #d6c100, #02b7ff, #ff4545, #d6c100, #02b7ff);
    background-size: 400% 400%;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    text-align: center;
    padding: 0px 5px;
}
.deals-md{
    animation: gradientinfinite 5s linear infinite alternate both;
    background-image: linear-gradient(45deg, #ff4545, #d6c100, #02b7ff, #ff4545, #d6c100, #02b7ff, #ff4545, #d6c100, #02b7ff);
    background-size: 400% 400%;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    text-align: center;
    padding: 0px 5px;
    height: fit-content;
    flex-shrink: 0;
}
.timer-stick{
    background-image: linear-gradient(180deg, rgb(255, 145, 0), rgb(218, 116, 32));
    border-radius: 5px;
    column-gap: 5px;
}
.timer-stick-md{
    background-image: linear-gradient(180deg, rgb(255, 145, 0), rgb(218, 116, 32));
    border-radius: 5px;
    column-gap: 5px;
    padding: 0px 5px;

}
.counts{
    display: flex;
    flex-direction: column;
    color: white;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 700;
}
.counts-md{
    display: flex;
    flex-direction: row;
    color: white;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    column-gap: 5px;
}
.timing{
    background-color: white;
    border-radius: 2px;
    color: black;
    width: 100%;
    text-align: center;
}
.timing-md{
    background-color: white;
    border-radius: 2px;
    color: black;
    width: 100%;
    text-align: center;
    padding: 0px 5px;
}
@media (max-width:1024px){
    .deal-countdown{
        display: none !important;
    }
    .deal-countdown-md{
        display: flex !important;
    }
}
@keyframes gradientinfinite{
    0% {
		background-position: 0%;
	}
	50% {
		background-position: 50%;
	}
	100% {
		background-position: 100%;
	}
}
