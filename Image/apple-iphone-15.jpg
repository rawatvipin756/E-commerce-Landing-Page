            <style>
                @media (max-width: 991px) {

                    /* Wrapper: column flow */
                    .header-with-down-input {
                        display: flex !important;
                        flex-direction: column !important;
                    }

                    /* ── Row 1: main header (menu | logo | icons) ── */
                    .main-header {
                        display: grid !important;
                        grid-template-columns: max-content 1fr max-content;
                        grid-template-rows: minmax(42px, auto);
                        align-items: center !important;
                        position: relative !important;
                        padding: 8px 12px 4px !important;
                        width: 100% !important;
                        order: 1 !important;
                        column-gap: 8px;
                    }

                    /* Logo — true center of header (not grid-column center) */
                    .main-header .logo {
                        position: absolute !important;
                        left: 50% !important;
                        top: 50% !important;
                        transform: translate(-50%, -50%) !important;
                        z-index: 1 !important;
                        width: max-content;
                        margin: 0 !important;
                    }

                    /* Menu — top-left */
                    .menu-buttons {
                        position: absolute !important;
                        left: 12px !important;
                        top: 8px !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        width: 42px !important;
                        height: 42px !important;
                        z-index: 2 !important;
                    }

                    /* Icons — top-right */
                    .main-buttons {
                        grid-column: 3;
                        grid-row: 1;
                        display: flex !important;
                        align-items: center !important;
                        gap: 6px !important;
                        z-index: 2 !important;
                        justify-self: end;
                        align-self: center;
