                e.preventDefault();
                if($("#example-bootstrap").val()){
                $('#reviewbtn').attr("disabled", "disabled");

                var data1 = new FormData(this);

                // If you want to add an extra field for the FormData
                data1.append("_token", "PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f");

                //console.log(data1);
                for (var x = 0; x <= 3; x++) {
                    if (typeof document.getElementsByClassName('multiImagesFiles')[x] !== 'undefined') {
                        data1.append("images[]", document.getElementsByClassName('multiImagesFiles')[x]
                            .files);
                    }
                }
                //    for (var pair of data1.entries()) {
                //    console.log(pair[0]+ ' - ' + pair[1]); 
                //}

                data = $('#reviewForm').serialize();
                //console.log(data);
                $.ajax({
                    type: 'post',
                    url: '/ajax-review-form',
                    data: data1,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function(data) {
                        //console.log(data);
                        if (data == "success") {
                            $("#reviewForm").css("display", "none");
                            $('#success1').html("<b class='text-success'>Review submitted - Thank you!</b>");
                            $("#reviewbtn").removeAttr("disabled");
                            $('#reviewForm').trigger("reset");
                        } else {
                            $("#reviewbtn").removeAttr("disabled");
                            $('#success1').html("<b class='text-danger'>"+data+"</b>");
                            $('#reviewForm').trigger("reset");
                        }
                    },
                    error: function(code) {
                        $("#reviewbtn").removeAttr("disabled");
                        $('#success1').html("<b class='text-danger'>"+code.statusText+"</b>");
                        $('#reviewForm').trigger("reset");
                    },
                });
                }else
                {
                    $("#reviewbtn").removeAttr("disabled");
                    $('#success1').html("<b class='text-danger'>Select one Star</b>");
                    $('#reviewForm').trigger("reset");
                }
            });


        // });

