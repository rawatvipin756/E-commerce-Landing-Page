    }
    
    .is_new_tag_apply_part
    {
                font-size: clamp(8px, 0.7vw, 15px);
                font-weight: 900;
                padding: 5px;
                border: 2px solid #b7b7b7;
                background-color: white;
                border-radius: 50px;
                color: red;
    }

</style>


<style>


:root{
    --primary-color:#d62929;
}
.background-primary{
    background-color: var(--primary-color);
}
body{
    font-family: "Lato", sans-serif;
    overflow-x: hidden;
}
header{
    z-index: 115;
    position: relative;
}
.ornament-with-light-left{
    transform: translateX(20%);
    left: 0;
}
.ornament-with-light-right{
    transform: translateX(-20%);
    right: 0;
}
.ornament-with-light-left, .ornament-with-light-right{
    height: 100%;
    z-index: 111;
    pointer-events: none;
    scale: 1.25;
}
.offer-div{
    padding: 10px 0px;
    background-color: var(--primary-color);
    font-size: 16px;
    font-weight: 800;
    scrollbar-width: none;
}
.offer-item{
    padding: 0px 20px;
    flex: 0 0 auto;
}
.search-container{
    flex: 1;
    outline: none;
    height: 40px;
    padding: 2px 20px;
    border: none;
    width: 100%;
}
.search-container::placeholder, .search-container{
    color: #6c757d;
}
.search-container:focus{
    color: #000000;
}
.header-navbar{
    width: 100dvw;
    z-index: 999;
    transition: all 0.3s ease-in-out;
    background-color: currentColor;
    background-image: var(--header-bg);
    background-position: top;
    background-repeat: repeat-x;
    background-size: contain;
    /* background-blend-mode: difference; */
    font-size: 1rem !important;
}
@media (max-width:768px){
    .header-navbar{
        background-size: cover;
    }
}
.header-with-down-input{
    border-bottom: 4px solid /*var(--primary-color)*/;
    border-image-slice: 1;
    position: relative;
    border-image-source: linear-gradient(90deg,orange 10%,yellow 20%,orange 30%,yellow 40%,orange 50%,yellow 60%,orange 70%,yellow 80%,orange 90%, yellow 100%);
    border-image-source: linear-gradient(90 deg,red 25%, yellow 50%, red 75%, yellow 100%);
}
.main-header{
    column-gap: 15px;
    z-index: 99;
    justify-content: space-evenly;
    /*background-image: url(../images/christmas-garlands.png);
    background-position: top;
    background-repeat: repeat-x;
    background-color: currentColor;
    background-size: contain;
    background-blend-mode: difference;*/
}
