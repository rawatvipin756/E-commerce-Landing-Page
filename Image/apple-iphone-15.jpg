    feather.replace();

    function delay(callback, ms) {
        var timer = 0;
        return function () {
            var context = this,
                args = arguments;
            clearTimeout(timer);
            timer = setTimeout(function () {
                callback.apply(context, args);
            }, ms || 0);
        };
    }


    function openSearch() {
        document.getElementById("search-overlay").style.display = "block";
    }

    function closeSearch() {
        document.getElementById("search-overlay").style.display = "none";
    }

    function loadButton(element) {
        var element = $("" + element + "");
        var loadStatus = element.data("loading");
        if (loadStatus == "loading") {
            element.data("loading", "normal");
            element.html(element.data("text"));
            element.prop('disabled', false);
        } else {
            element.prop('disabled', true);
            element.data("text", element.html());
            element.data("loading", "loading");
            element.html('Please Wait...');
        }
    }
    $(document).on('click', '#login', function () {
        $('#loginModal').modal('show');
    })
    $("#loginForm").validate({
        rules: {
            mobile: {
                required: true,                  
                minlength: 10,
                maxlength: 10,
            },


        },
        errorPlacement: function (error, element) {
            if (element.hasClass("select2-hidden-accessible")) {
                error.insertAfter(element.siblings('span.select2'));
            } else if (element.hasClass("floating-input")) {
                element.closest('.form-floating-label').addClass("error-cont").append(error);
            } else {
                error.insertAfter(element);
            }
        },
        submitHandler: function (form) {

            var data = new FormData(form);
            loadButton('#login-btn');
            $.ajax({
                type: "POST",
                url: "/auth/send_otp",
                data: data,
                processData: false,
                contentType: false,
                // dataType: "json",
                success: function (data) {
                    loadButton('#login-btn');
                    if (data == "Success") {
                        $('#loginForm').addClass('d-none');
                        $('#otpForm').removeClass('d-none');
                        $('#otpmobile').val($('#mobile').val());
                        $('#sent_to').html(`sent to ${$('#mobile').val()}`);
                    } else if (data = "CookieMobileSuccess") {
                        
                        Toast.fire({
                        icon: "success",
                        title: "Successfully Loggedin"
                        });
                        setTimeout(function(){
                            location.reload();
                        },2000)
                    } else {
                        console.log(data);
                    }
                }

            });

        }
    });
    $("#otpForm").validate({
        rules: {
            mobile: {
                required: true
            },
            uotp: {
                required: true
            },


        },
        errorPlacement: function (error, element) {
            if (element.hasClass("select2-hidden-accessible")) {
                error.insertAfter(element.siblings('span.select2'));
            } else if (element.hasClass("floating-input")) {
                element.closest('.form-floating-label').addClass("error-cont").append(error);
            } else {
                error.insertAfter(element);
            }
        },
        submitHandler: function (form) {

            var data = new FormData(form);
            loadButton('#submit_otp');
            $.ajax({
                type: "POST",
                url: "/auth/verify_otp",
                data: data,
                processData: false,
                contentType: false,
                // dataType: "json",
                success: function (data) {
                    loadButton('#submit_otp');
                    console.log(data);
                    if (data == "Success") {
                        $('.otp_error').addClass('d-none');
                        
                        Toast.fire({
                        icon: "success",
                        title: "Sucessfully Loggedin"
                        });
                        setTimeout(function(){
                            location.reload();
                        },2000)
                    } else {
                        $('.otp_error').removeClass('d-none').html(data);
                    }
                }

            });

        }
    });
    $(document).on('click', '#resend_otp', function () {
        $('#loginForm').trigger('submit');
    })
    //dropdown on  click //
