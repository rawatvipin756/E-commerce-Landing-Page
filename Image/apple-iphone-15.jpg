<div class="modal pr-0" id="loginModal" style="z-index: 10000;" tabindex="-1" role="dialog"
    aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content auth-modal">
            <div class="p-2">
                <span data-bs-dismiss="modal" aria-label="Close" class="cursor-pointer" style="float:right">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25px" height="25px" viewBox="0 0 1024 1024">
                        <path fill="#000000"
                            d="M195.2 195.2a64 64 0 0 1 90.496 0L512 421.504 738.304 195.2a64 64 0 0 1 90.496 90.496L602.496 512 828.8 738.304a64 64 0 0 1-90.496 90.496L512 602.496 285.696 828.8a64 64 0 0 1-90.496-90.496L421.504 512 195.2 285.696a64 64 0 0 1 0-90.496z" />
                    </svg>
                </span>
            </div>
            <div class="modal-body pt-0">
                <form id="loginForm" class="loginForm">
                    <input type="hidden" name="_token" value="PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f" autocomplete="off">
                    <div class="login-outer">
                        <div class="login-create">
                            <label class="login mb-0">Login</label>
                            <label class="create-account mb-0">Create Account</label>
                        </div>
                        <div class="pt-3 login-input">
                            <label for="" class="mb-3 ">Please enter your phone number</label>
                            <input type="number" name="mobile" id="mobile"
                                placeholder="Enter your Phone number">
                        </div>
                        <div class="pt-3 login-input">
                            <label>
                                <input type="checkbox" checked>
                                I have read and agree to the <a href="/terms-and-conditions" class="text-danger">Terms and Conditions.</a>
                            </label>
                        </div>

                        <div class=" py-3 login-submit w-100 d-flex flex-column align-items-center">
                            <button type="submit" class="login-btn btn" id="login-btn">Continue</button>
                        </div>
                    </div>
                </form>
                <form id="otpForm" class="otpForm d-none">
                    <input type="hidden" name="_token" value="PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f" autocomplete="off">
                    <div class="login-outer">
                        <div class="pt-3 w-100 d-flex flex-column align-items-center">
                            <label for="" class="mb-3 otp-label"><b>Verify with OTP</b></label>
                            <label class="sent_to mb-3" id="sent_to"></label>
                            <input type="text" name="uotp" id="uotp" class="mb-3"
                                placeholder="Enter the OTP">
                            <span class="mb-3 otp_error d-none text-danger"></span>
                            <input type="hidden" name="mobile" id="otpmobile">
                            <div class="d-flex align-items-center justify-content-center">
                                <label for="" class="mb-0"><b>Don't Receive Your OTP?</b> </label>
                                <button type="button" class="remove_btn_border" href="javascript:void(0);"
                                    id="resend_otp">Resend OTP</button>
                            </div>
                        </div>
                        <div class=" py-3 login-submit w-100 d-flex flex-column align-items-center">
                            <button type="submit" class="login-btn btn " id="submit_otp">Submit OTP</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .login-create {
        display: flex;
        border-radius: 4px;
        border: 1px solid #353535;
    }

    .login-outer {
        display: flex;
        align-items: center;
        flex-direction: column;
    }

    .login {
        border-right: 1px solid #353535;
    }

    .login::after {
        content: 'OR';
        position: absolute;
        margin-right: -148px;
        background: white;
        padding: 2px 4px;
        border: 1px solid #353535;
        border-radius: 4px;
    }

    .login,
    .create-account {
        width: 150px;
        padding: 15px 0px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-input {
        display: flex;
        align-items: center;
        flex-direction: column;
        width: 100%;
    }

    #mobile,
    #uotp {
        max-width: 300px;
        width: 100%;
        padding: 10px;
        font-size: 17px;
        letter-spacing: 1px;
    }

    /* .otp-label{
   max-width: 300px;
   width: 100%;
  } */
