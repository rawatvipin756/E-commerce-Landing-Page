         $(document).ready(function(){
    
    $('#exchange_type_select').change(function(){
        if($(this).val != ''){
            $("#exchange_type_select").find("option[id='empty']").hide();
            //$('#exchange_type_select').attr('disabled','disabled');
            $('#exchange_brand_select').removeAttr('disabled');
        }
    });

    $('#exchange_brand_select').change(function(){
        if($(this).val != ''){
            $("#exchange_brand_select").find("option[id='empty']").hide();
            $('#exchange_condition_select').removeAttr('disabled');
        }
    });

    $('#exchange_condition_select').change(function(){
        $("#exchange_condition_select").find("option[id='empty']").hide();
        //$("#fixedamountdiv").show();
        $('#exchange_pincode').removeAttr('disabled');
        $('#exchange_pincode_btn').removeAttr('disabled');


    });


    $('#exchange_pincode_btn').click(function(){

        $("#fixedamountdiv").hide();
        var epin = $("#exchange_pincode").val();
        var etype = $("#exchange_type_select").val();
        var ebrand = $("#exchange_brand_select").val();
        var econd = $("#exchange_condition_select").val();

        var cat_name = 'Mobiles';

        $.ajax({
                type:'post',
                url:'/check_exchange_pincode',
                data: {epin:epin,etype:etype,ebrand:ebrand,econd:econd,cat_name:cat_name,_token: 'PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f'},
                success:function(data){

                    if(data=="noexchange"){
                        alert('Exchange service is not available for this location');
                    }else if(data=="noamount"){
                        alert('Exchange service is not available for this condition');
                    }else{
                        $("#exchange_amnt_div").html(' Fixed Exchange value: ₹'+data);
                        $("#fixedamountdiv").show();

                    }

                }
                
                    


                

            });




    });
});
    </script>
    <script type="text/javascript">
    $(".rateing .fa-star").click(function () {
        var rate_val = $(this).data('rate');
        $(".rateing .fa-star").removeClass("checked");
        for (var i = 1; i <= rate_val; i++) {
            $(".fa" + i).addClass("checked");
        }
        $("#example-bootstrap").val(rate_val);
    });
