.category-scroll{
    width: 100%;
    overflow: auto;
    box-shadow: 0px 1px 4px #757575;
    background-color: #d62929;
}/*
.category-scroll::-webkit-scrollbar{
    height: 6px;
    width: 0px;
}
.category-scroll::-webkit-scrollbar-track{
    background: #d62929;
}
.category-scroll::-webkit-scrollbar-thumb{
    background: #f9ec25;
    border: 2px solid #d62929;
    border-radius: 20px;
}*/
.category-scroll div .main-cat-name{
    color: white;
    display: block;
    padding: 7.5px 15px;
}
.main-cat-name:hover{
    color: white !important;
}
.scroll-element{
    column-gap: 20px;
}
.main-category{
    position: relative;
}
.sub-category{
    display: flex;
    position: fixed;
    opacity: 0;
    visibility: hidden;
    transform: translateX(50px);
    pointer-events: none;
    z-index: 999;
    box-shadow: 0px 0px 5px #000000;
    border-radius: 4px;
    transition: all 0.3s ease-in-out;
}
.sub-category.show{
    opacity: 1;
    visibility: visible;
    transform: translateX(0px);
    pointer-events: auto;
}
.sub-category div img{
    width: inherit;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
.text-area, .text-area > :first-child{
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}
.text-area > :nth-child(odd){
    background-color: #f5f5f5;
}
.text-area > :nth-child(even){
    background-color: white;
}
.text-area {
    display: flex;
}
.column{
    max-width: fit-content;
}
.text-area .column h6{
    padding: 10px;
}
.text-area .column h6 a{
    color: var(--primary-color);
    font-weight: 900;
    text-decoration: none;
    appearance: none;
}
.text-area .column li a{
    text-decoration: none;
    appearance: none;
    display: block;
    color: #484848;
    font-weight: 600;
    font-size: small;
}
.text-area .column li a:hover{
    color: var(--primary-color) !important;
}
.sub-category > :last-child{
    background-color: none;
    width: 200px;
    color:none;
}
.sub-category div ul{
    list-style-type: none;
    padding: 0px 10px;
    margin: 0;
}
.sub-category div li{
    padding: 5px 25px;
    list-style-type: none;
    display:flex;
}
.sub-category div h6{
    margin: 0;
}
@media (max-width: 991px){
    .offer-item{
        width: 50%;
    }
    .main-header{
        justify-content: space-around;
        column-gap: 10px;
    }
    .main-buttons{
        margin-left: 0px;
        margin-right: 0px;
    }
    .logo{
        margin-right: 0px;
    }
    .category-scroll{
        display: none;
    }
    .tv-access-menu-banner{
        border-top-left-radius: 0px !important;
        border-top-right-radius: 0px !important;

    }
    .tv-and-accessories-menu{
        /* border-radius: 0px !important; */
        border-bottom-right-radius: 15px !important;
        border-bottom-left-radius: 15px !important;
        /* border-top: 0px !important; */
    }
    .sidebanner-anchor {
        border-radius: 0px !important;
        border-top-right-radius: 15px !important;
        border-top-left-radius: 15px !important;
        border: 3px solid #dedede;
    }
    .sidebanner-anchor img{
        border-radius: 0px !important;
    }
}
@media (max-width: 650px){
    .offer-item{
        width: 100%;
    }
}
.carousel-indicators {
    padding: 0px 10px;
    background-color: #ffffffce !important;
    width: fit-content;
    margin-left: auto !important;
    margin-right: auto !important;
    border-radius: 50px;
}
.carousel-indicators button {
    width: 10px !important;
    height: 10px !important;
    background-color: #ccc;
    border-radius: 50%;
    margin: 6px 9px !important;
    transition: 0.3s;
    border: 1.5px solid var(--primary-color) !important;
}

.carousel-indicators .active {
    background-color: var(--primary-color);
    scale: 1.1;
}
.carousel-control-prev{
    transform: translate(25px, -50%);
}
.carousel-control-next{
    transform: translate(-25px, -50%);
}
.carousel-control-prev,
.carousel-control-next {
    width: 40px;
    height: 40px;
    background: #dddddd9c;
    border-radius: 50%;
    top: 50%;
    box-shadow: 0px 0px 4px #000000;
}
@media (max-width:767px){
    .carousel-control-prev,
    .carousel-control-next {
        width: 35px !important;
        height:35px !important;
    }
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        width: 20px !important;
        height: 20px !important;
    }
    .carousel-control-prev-icon i, .carousel-control-next-icon i{
        font-size: 30px !important;
    }
}
.carousel-control-prev:hover .carousel-control-prev-icon i, .carousel-control-prev:focus .carousel-control-prev-icon i,
.carousel-control-next:hover .carousel-control-next-icon i, .carousel-control-next:focus .carousel-control-next-icon i{
    color: var(--primary-color) !important;
}
.carousel-control-prev:focus, .carousel-control-prev:hover, .carousel-control-next:focus, .carousel-control-next:hover{
    border: 1px solid var(--primary-color);
}
.carousel-control-prev-icon,
.carousel-control-next-icon {
    width: 30px;
    height: 30px;
    background-image: none !important;
    display: flex;
    justify-content: center;
}
.carousel-control-prev-icon i,
.carousel-control-next-icon i{
    font-size: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
}
@media (max-width:767px){
    .feature-highlight, .feature-des{
        font-size: 14px;
    }
    .feature-img{
        width: 50px;
    }
}
@media (max-width:576px){
    .menu-title-side-buttons{
        column-gap: 5px !important;
    }
    .logo .logo-img{
        width: 75px;
    }
    .logo .santa-hat-img{
        width: 35px;
    }
    .logo .santa-hat{
        top: -20px;
    }
}
@keyframes pop {
    0%{
        scale: 1;
    }    
    25%{
        scale: 1.2;
    }
    50%{
        scale: 1;
    }
    75%{
        scale: 0.8;
    }
    100%{
        scale: 1;
    }
}
.contents-body{
    /* margin: 0px 10px; */
}
.category-menus{
    margin: 20px 0px 0px 0px;
}
.category-menu-title{
    display: flex;
    justify-content: center;
    column-gap: 30px;
    margin-bottom: 15px;
}
.category-menu-title::-webkit-scrollbar{
    width: 0px;
    height: 0px;
}
.menu-title-card{
    display: flex;
    flex-direction: column;
    align-content: center;
    justify-items: center;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    row-gap: 10px;
    width: 140px;
}
.category-title-img{
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid #b0b0b0;
    transition: all 0.2s ease-in-out;
}
menu-title{
    text-align: center;
    transition: all 0.2s ease-in-out;
    font-weight: 900;
}
.category-menu-title-wrapper{
        /* display: flex; */
    overflow: auto;
    /* justify-content: center; */
    max-width: 1000px !important;
    margin-inline: auto;
}
.inner-section-padding{
    padding: 0px 60px;
}
.current-menu-item-title{
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0px 10px 10px 10px;
    border-bottom: 2px solid #b7b7b7;
}
.menu-title-card:hover .category-title-img, .menu-title-card:focus .category-title-img{
    border-color: var(--primary-color);
}
.menu-title-card:hover menu-title, .menu-title-card:focus menu-title{
    color: var(--primary-color);
}
.menu-title-card.selected-menu-title .category-title-img{
    border-color: var(--primary-color);
}
.menu-title-card.selected-menu-title menu-title{
    color: var(--primary-color);
}
.menu-title-card menu-title{
    word-break: break-Word;
}
.menu-item-control-prev,
.menu-item-control-next {
    width: 30px;
    height:30px;
    background: #dddddd9c;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
}
.menu-item-control-prev:hover .menu-control-prev-icon i, .menu-item-control-prev:focus .menu-control-prev-icon i,
.menu-item-control-next:hover .menu-control-next-icon i, .menu-item-control-next:focus .menu-control-next-icon i{
    /* color: var(--primary-color) !important; */
}
.menu-item-control-prev:focus, .menu-item-control-prev:hover, .menu-item-control-next:focus, .menu-item-control-next:hover{
    border: 1px solid var(--primary-color);
}
.menu-control-prev-icon,
.menu-control-next-icon {
    width: 20px;
    height: 20px;
    background-image: none !important;
    display: flex;
    justify-content: center;
}
.menu-control-prev-icon i,
.menu-control-next-icon i{
    font-size: 20px;
    display: flex;
    align-items: center;
    color: #606060;
    justify-content: center;
}
.menu-title-side-buttons{
    justify-content: space-between;
    align-items: flex-end;
    column-gap: 10px;
}
.category-menu-products{
    padding: 20px !important;
    margin: 20px 0px 0px 0px;
    background-color: #ececec;
    border-radius: 10px;
}
.category-menu-products-row{
    display: none !important;
    overflow: visible;
}
.category-menu-products-row.selected-menu{
    display: flex !important;
}
.category-menu-products-row {
  /*opacity: 0;
  transition: opacity .3s ease;*/
}

.category-menu-products-row.selected-menu {
  opacity: 1;
}
.category-menu-products-row::-webkit-scrollbar{
    width: 0px;
    height: 0px;
}
.menu-product-card{
    margin-right: 15px;
    background-color: #fff;
    padding: 10px;
    border-radius: 10px;
}
.menu-product-card a{
    appearance: none;
    text-decoration: none;
    color: #000000;
}
.menu-product-card:hover{
    box-shadow: 2px 0px 4px #b3b3b3;
}
@media (max-width:950px){
    .category-menu-title{
        overflow: auto;
        justify-content: flex-start;
    }
    .inner-section-padding{
        padding: 0px 20px;
    }
}
@media (max-width:756px){
}
@media (max-width:756px){
    .inner-section-padding{
        padding: 0px 10px;
    }
    .menu-product-title{
        font-size: small;
    }
    .rating span{
        font-size: 20px !important;
    }
    .menu-product-sp{
        font-size: medium !important;
    }
    .menu-product-mrp{
        font-size: smaller !important;
    }
    .menu-product-image{
        min-height: 130px !important;
    }
}
.menu-product-image{
    width: 100%;
    min-height: 200px;
    object-fit: cover;
    object-position: center;
    border-radius: 10px;
    transition: all 0.3s ease-in-out;
}
.menu-product-details{
    display: flex;
    flex-direction: column;
    margin-top: 15px;
}
.menu-product-details a{
    text-decoration: none;
    appearance: none;
    color: #000000;
}
.menu-product-details .menu-product-title{
    margin-bottom: 0px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.rating {
  color: gray;
  line-height: normal;
  text-align: center;
}
.rating > :not(:last-child){
    margin-right: 5px;
}
.rating span {
  color: gray;
  font-size: 25px;
}
.rating span.filled {
  color: gold !important;
}
.menu-product-sp{
    text-align: center;
    font-weight: 700;
    font-size: large;
    margin-top: 5px;
}
.menu-product-mrp{
    text-align: center;
    font-weight: 500;
    font-size: medium;
    margin-top: 5px;
    text-decoration: line-through;
    color: var(--primary-color);
}
.menu-product-buttons{
    display: flex;
    column-gap: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translate(-30px, 30px);
    transition: all 0.3s ease-in-out;
}
.menu-product-buttons button{
    width: 35px;
    height: 35px;
    box-shadow: 0px 0px 10px var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 50%;
    border: 2px solid #b3b3b3;
    color: var(--primary-color);
    transition: all 0.2s ease-in-out;

}
.menu-product-buttons button:hover{
    border:2px solid var(--primary-color);
    background-color: var(--primary-color) !important;
    color: white !important;
    scale: 1.1;
}
.menu-product-buttons button span i{
    display: flex;
}
.menu-product-card:hover .menu-product-buttons, .menu-product-card-2:hover .menu-product-buttons{
    transform: translate(-50%, -50%) !important;
    opacity: 1 !important;
    visibility: visible !important;
}
.menu-product-card:hover .menu-product-title, .menu-product-card-2:hover .menu-product-title{
    color: var(--primary-color) !important;
}
.menu-product-card:hover .menu-product-image, .menu-product-card-2:hover .menu-product-image{
    scale: 1.1;
}
@media (max-width:768px){
    .menu-product-buttons{
        opacity: 1 !important;
        visibility: visible !important;
        transform: translate(-50%, -50%) !important;
    }
}
.top-home-appliance-category{
    border: 2px solid #bfbfbf;
    border-radius: 20px;
    padding: 20px;
    margin: 30px 0px 0px 0px;
}
.top-home-menu-title{
    padding: 0px 10px 15px 10px;
    border-bottom: 1px solid #939393;
}
.top-home-menu-title-wrap, .tv-and-acess-menu-title-wrap{
    margin: 10px 0px 0px 0px;
    padding: 0px 10px;
    display: flex;
    justify-content: space-around;
    column-gap: 15px;
}
.top-home-cat-title, .tv-and-access-cat-title{
    padding: 5px 20px;
    border: 2px solid var(--primary-color);
    border-radius: 50px;
    flex: 1 0 15%;
}
.tv-and-acess-menu-title-wrap{
    width: fit-content;
}
.tv-and-access-cat-title{
    flex-basis: 0 !important;
    width: 200px !important;
}
@media(max-width:1024px){
    .top-home-cat-title{
        flex-basis: 30%;
    }
}
@media(max-width:768px){
    .top-home-cat-title{
        flex-basis: 45%;
    }
}
@media(max-width:576px){
    .top-home-cat-title{
        flex-basis: 95%;
    }
}
.menu-title-card.top-home-cat-title.selected-menu-title, .tv-and-access-cat-title.selected-menu-title{
    background-color: var(--primary-color);
}
.top-home-cat-title menu-title, .tv-and-access-cat-title menu-title{
    color: var(--primary-color);
    font-weight: 400;
    cursor: pointer;
}
.top-home-cat-title.selected-menu-title menu-title, .tv-and-access-cat-title.selected-menu-title menu-title{
    color: white;
}
.top-home-menu-products{
    padding: 20px 40px 0px 40px;
    background-color: transparent;
    position: relative;
}
.tv-and-accessories-menu-products{
    padding: 0px;
    background-color: transparent;
    position: relative;
}
@media(max-width:576px){
    .top-home-menu-products{
        padding: 0px !important;
    }
    .panaromic-banner{
        margin: 20px 0px -10px 0px !important;
    }
    .multi-banner{
        flex-wrap: wrap !important;
    }
    .multi-banner > :not(:last-child){
        margin-bottom: 20px;
    }
    .panaromic-banner img{
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: right;
    }
}
.top-home-menu-products .menu-item-control-prev{
    left: -10px;
    top: 50%;
}
.top-home-menu-products .menu-item-control-next{
    right: -10px;
    top: 50%;
}
.top-home-menu-products .menu-item-control-prev, .top-home-menu-products .menu-item-control-next{
    transform: translateY(-50%);
    position: absolute;
    background-color: var(--primary-color);
    width: 40px;
    height: 40px;
    z-index: 90;
}
.top-home-menu-products .menu-item-control-prev span, .top-home-menu-products .menu-item-control-next span{
    width: 30px;
    height: 30px;
}
.top-home-menu-products .menu-item-control-prev span i, .top-home-menu-products .menu-item-control-next span i{
    color: #eaeaea;
    font-size: 30px;
}
.top-home-menu-products .menu-item-control-prev:hover, .top-home-menu-products .menu-item-control-next:hover, .top-home-menu-products .menu-item-control-prev:focus, .top-home-menu-products .menu-item-control-next:focus{
    box-shadow: 0px 0px 5px #000000;
}
.top-home-menu-products .menu-item-control-prev:hover span i, .top-home-menu-products .menu-item-control-next:hover span i,.top-home-menu-products .menu-item-control-prev:focus span i, .top-home-menu-products .menu-item-control-next:focus span i{
    color: #eaeaea !important;
}
.menu-product-card-2{
    background-color: #fff;
    padding: 10px;
    border-radius: 10px;
    box-shadow: 0px 0px 5px #939393;
}
.menu-product-card-2 tags, .menu-product-card tags{
    position: absolute;
    z-index: 99;
    display: flex;
    column-gap: 5px;
}
.menu-product-card-2 .top-home-pr-img{
    border-bottom: 2px solid lightgray;
}
.menu-product-card-2 tags tagel, .menu-product-card tags tagel{
    color: var(--primary-color);
    border-radius: 50px;
    font-size: clamp(8px, 0.7vw, 15px);
    font-weight: 900;
    padding: 5px;
    border: 2px solid #b7b7b7;
    background-color: white;
}
.panaromic-banner{
    margin:40px 0px 10px 0px; border-radius: 20px; 
    display: inline-block;
}
.tv-and-accessories-menu{
    padding: 10px 10px 0px 10px;
    border: 3px solid #dedede;
    border-radius: 10px;
    margin-top: 0px !important;
}
.tv-access-menu-banner{
    object-fit: cover;
    object-position: center;
    border-radius: 20px;
}
footer{
    background-color: #1e1e1e;
    margin-top: 50px;
    padding: clamp(10px, 3dvw, 60px);
    padding-top: clamp(10px, 1.5vw, 40px) !important;
    padding-bottom: clamp(10px, 1.5vw, 40px) !important;
}
.footer-items{
    column-gap: 15px;
}
.footer-menus{
    flex-wrap: wrap;
    column-gap: 10px;
}
.footer-menus span{
    color: #6d6e68;
    font-size: clamp(16px, 1.3vw, 40px);
    position: relative;
}
.footer-menus a{
    text-decoration: none;
    appearance: none;
    width: fit-content;
}
.footer-menus > :not(:last-child){
    margin-bottom: 10px;
}

.footer-menus span:before {
    position: absolute;
    top: 25px;
    content: "";
    height: 2px;
    width: 0;
    background-image: linear-gradient(90deg, var(--primary-color) 0%, rgb(175, 93, 0) 100%);
    -webkit-transition: 0.5s ease;
    transition: 0.5s ease;
}
.footer-menus a:hover span:before{
    width: 100% !important;
}
.footer-menus a:hover span{
    color: white;
}

.brand-carousel{
    width: 100%;
    overflow-x: auto;
    display: flex;
    margin-bottom: 50px;
    margin-top: 10px;
}
.brand-carousel::-webkit-scrollbar{
    display: none;
}
.group{
    display: flex;
    align-items: center;
    justify-content: center;
    column-gap: 20px;
    animation: slider 30s infinite linear;
    padding-right: 2rem;
}
.brand-card img{
    width: 100px;
    filter: grayscale(1);
}
.brand-card:hover img{
    filter: grayscale(0) !important;
}
@keyframes slider{
    from{
        transform: translate(0%);
    }
    to{
        transform: translate(-100%);
    }
}
.card-image{
    text-align: center;
    padding: 0px 10px 0px 10px;
    border-right: 1px dotted;
}
.card-texts{
    display: flex;
    flex-direction: column;
    row-gap: 5px;
}
.card-modals{
    height: 60px;
    column-gap: 10px;
    width: 250px;
    border: 1px solid #b3b3b3;
    border-radius: 4px;
    flex-shrink: 0;
}
.card-modal-wrapper{
    border-bottom: 1px dotted black;
}
#snowCanvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9999;
}
.brands-head{
    background-image: linear-gradient(135deg, var(--primary-color) 10%, #f9ec25 100%);
    padding: 0px 20px;
    width: fit-content;
    border-radius: 50px;
    margin-bottom: 20px;
}

.snow {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.snow.blurred    { z-index: 1000; opacity: 0.6; font-weight: 700;}
.snow.clear      { z-index: 1001; opacity: 0.8; font-weight: 700;}
.snow.very-clear { z-index: 1002; opacity: 0.8; font-weight: 700;}

.flake-wrap {
  position: absolute;
  top: -10vh;
  will-change: transform;
  animation-name: fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.flake {
  display: inline-block;
  will-change: transform;
  animation-name: sway;
  animation-direction: alternate;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
  line-height: 1;
}

/* FALL ONLY USES TRANSFORM */
@keyframes fall {
  to {
    transform: translateY(110vh);
  }
}

/* VERY LIGHT SWAY */
@keyframes sway {
  from { transform: translateX(0) rotate(0deg); }
  to   { transform: translateX(var(--sway)) rotate(var(--rot)); }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .flake-wrap,
  .flake {
    animation: none !important;
  }
}

@media (min-width: 400px) and (max-width: 557px) {
     .mobile-cart .show-div.shopping-cart {
        /* top: 0px; */
        /* bottom: 42px; */
        left: -327px !important;
        /* margin-top: 5.5rem; */
    }
}

</style>




