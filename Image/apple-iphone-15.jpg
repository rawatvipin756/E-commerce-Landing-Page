<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script>
    let lat_value = '';
    let lng_value = '';

    // Get current location
    if (navigator.geolocation) {

        navigator.geolocation.getCurrentPosition(
            function(position) {

                lat_value = position.coords.latitude;
                lng_value = position.coords.longitude;

                console.log(lat_value, lng_value);
                
            },
            function(error) {
                console.log(error.message);
            }
        );

    }

    // Show modal if no pincode
    $(document).ready(function() {

        let userPincode = "";
      
        if (!userPincode) {
            let currentRoute = "sathya.product";
           
            let locationModal = new bootstrap.Modal(
                document.getElementById('locationModal')
            );
            if("login" != currentRoute){
                locationModal.show();
            }
           
        }

    });

    // Pincode Submit
    function submitPincode() {

        let pincode = $('#pincode_first').val().trim();

        if (pincode.length !== 6 || isNaN(pincode)) {
            alert('Please enter valid 6 digit pincode');
            return;
        }

        selectLocation(pincode);
    }

    // Location Select
    function selectLocation(pincode) {
        
        let data = {
            _token: 'PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f'
        };

        if (pincode === 'default') {

            if (!lat_value || !lng_value) {
                alert('Location not available');
                return;
            }

            data.latitude = lat_value;
            data.longitude = lng_value;

        } else {

            data.pincode = pincode;
        }

        $.ajax({
            url: '/check-pincode-state',
            type: 'POST',
            data: data,

            success: function(response) {

                if (response.status) {
                    location.reload();
                }

            },

            error: function() {
                alert('Something went wrong');
            }
        });

    }
</script>
