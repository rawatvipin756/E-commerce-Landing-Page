        function econnectParam($p_title, $p_url, $cat) {

            $("#e_product").val($p_title);
            $("#e_product_url").val($p_url);
            $("#e_product_category").val($cat);


        }

        function displaystockParam($p_title, $p_url, $cat) {

            $("#display_stock_product").val($p_title);
            $("#display_stock_product_url").val($p_url);
            $("#display_stock_product_category").val($cat);

            $("#displayStockModal").modal("show");

