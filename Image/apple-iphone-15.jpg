                            <style>
                            .cart-wrapper {
                                position: relative;
                            }

                            .cart-dropdown {
                                position: absolute;
                                right: 0;
                                top: 100%;
                                width: 350px;
                                background: #fff;
                                z-index: 1200;
                                display: none;
                                border-radius: 8px;
                            }

                            .cart-dropdown.show {
                                display: block;
                            }

                            /* Desktop hover support */
                            @media (min-width: 992px) {
                                .cart-wrapper:hover .cart-dropdown {
                                    display: block;
                                }
                            }

                            /* Mobile fix */
                            @media (max-width:768px) {
                                .cart-dropdown {
                                    right: -69px;
                                    width: 300px;
                                }
                            }
                            </style>


                            <li class="position-relative mobile-cart ajaxviewcart_append p-0 cart-wrapper">

                                <!-- Cart Icon -->
                                <div class="cart-i position-relative"
                                    style="background-color: white; padding: 5px; border-radius: 50px; cursor:pointer;">
                                    
                                    <i class="fi fi-rs-shopping-cart d-flex fs-3"
                                        style="color: var(--primary-color);"></i>

                                    <span class="position-absolute py-1 px-2 top-0 start-100 translate-middle badge bg-danger rounded-circle"
                                        style="font-size:0.8rem">
                                        0
                                    </span>
                                </div>

                                <!-- Cart Dropdown -->
                                <div class="cart-dropdown position-absolute end-0 mt-2 bg-white border rounded shadow">


                                        <!-- d-none -->

                                        
                                        <div class="p-3 border-bottom fw-semibold">
                                            Cart Items
                                        </div>

                                        
                                        <div style="max-height:260px; overflow-y:auto;">

                                            
                                                                                    </div>

                                        
                                        <div class="p-3 border-top">

                                            
                                            <div class="d-flex justify-content-between fw-semibold mb-3">
                                                <span>Subtotal</span>
                                                <span>₹0</span>
                                            </div>

                                            <a href="/viewcart?view=all" class="btn btn-primary w-100">
                                                View Cart
                                            </a>
                                        </div>                                     
                                </div>

                            </li>

                            <script>
                            $(document).ready(function(){

                                // Toggle on click (mobile + desktop click support)
                                $(document).on('click', '.cart-i', function(e){
                                    e.stopPropagation();
                                    $('.cart-dropdown').toggleClass('show');
                                });

                                // Close when clicking outside
                                $(document).on('click', function(e){
                                    if (!$(e.target).closest('.cart-wrapper').length) {
                                        $('.cart-dropdown').removeClass('show');
                                    }
                                });

                            });
                            </script>
                            
                                      
