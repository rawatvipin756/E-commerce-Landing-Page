    .onhover-div .show-div.shopping-cart {
    padding: 15px 10px;
    min-width: 30rem;
    /*left: unset; */
    right: 0;
    height:auto;
    overflow-y:scroll;
    max-height: 500px;
}

/* .onhover-div .show-div.shopping-cart::-webkit-scrollbar {
    width: 2em;
} */

.onhover-div .show-div.shopping-cart li {
    position: relative;
    padding-bottom: 10px;
    width: 100%
}

.onhover-div .show-div.shopping-cart li:last-child {
    padding-bottom: 0
}

.onhover-div .show-div.shopping-cart li .media img {
    height: 90px
}

.onhover-div .show-div.shopping-cart li .media .media-body {
    -ms-flex-item-align: center;
    align-self: center
}

.onhover-div .show-div.shopping-cart li .media .media-body h4 {
    color: #333
}

.onhover-div .show-div.shopping-cart li .media .media-body h4 span {
    color: #777;
    font-size: 16px
}

.onhover-div .show-div.shopping-cart li .close-circle {
    position: absolute;
    top: 0;
    right: 0
}

.onhover-div .show-div.shopping-cart li .close-circle i {
    color: #a1a1a1;
    -webkit-transition: all 0.3s ease;
    transition: all 0.3s ease
}

.onhover-div .show-div.shopping-cart li .close-circle i:hover {
    color: #000;
    -webkit-transition: all 0.3s ease;
    transition: all 0.3s ease
}

.onhover-div .show-div.shopping-cart li .total {
    border-top: 1px solid #f1f5f4;
    border-bottom: 1px solid #f1f5f4;
    padding-top: 10px;
    padding-bottom: 10px
}

.onhover-div .show-div.shopping-cart li .total h5 {
    text-transform: capitalize;
    margin-bottom: 0;
    color: #999
}

.onhover-div .show-div.shopping-cart li .total h5 span {
    float: right
}

.onhover-div .show-div.shopping-cart li .buttons a {
    font-size: 16px;
    text-transform: capitalize;
    font-weight: 700
}

.onhover-div .show-div.shopping-cart li .buttons a:hover {
    color: var(--theme-color)
}

.onhover-div .show-div.shopping-cart li .buttons .checkout {
    float: right
}

.onhover-div .show-div.setting {
    padding: 15px 20px 20px;
    min-width: 175px;
    right: 0;
    left: unset
}

.onhover-div .show-div.setting h6 {
    font-size: 16px;
    text-transform: capitalize;
    color: #333;
    font-weight: 700;
    margin-bottom: 0;
    margin-top: 5px
}

.onhover-div .show-div.setting h6:first-child {
    margin-top: 0
}

.onhover-div .show-div.setting ul li {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    padding-bottom: 0;
    padding-left: 17px;
    padding-top: 5px
}

.onhover-div .show-div.setting ul li a {
    color: #333;
    font-weight: 400;
    font-size: 16px;
    text-transform: capitalize
}

.onhover-div .show-div li {
    padding: 0
}

.onhover-div .show-div li .form-control {
    border-radius: 0
}

.onhover-div .show-div li .form-control:focus {
    border: 1px solid #ced4da;
    -webkit-box-shadow: none;
    box-shadow: none
}

.onhover-div .show-div li .search-btn {
    padding: 8px 12px;
    background-color: var(--theme-color);
    color: #fff
}

.onhover-div img {
    -webkit-filter: brightness(5);
    filter: brightness(5)
}

.onhover-div .show-div img {
    -webkit-filter: none;
    filter: none
}

