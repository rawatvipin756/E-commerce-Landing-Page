    }

    .option-input:checked::before {
        height: 25px;
        width: 18px;
        position: absolute;
        content: '✔';
        display: inline-block;
        font-size: 16.66667px;
        text-align: center;
        line-height: 18px;
    }

    .option-input:checked {
        background: #d72727;
    }


    .option-input:checked::after {
        background: #d72727;
        content: '';
        display: block;
        position: relative;
        z-index: 100;
    }

    ul.onhover-show-div {
        margin-right: -66px;
    }

    /* dorpdown */
    .selected span {
        display: flex;
        background: rgba(0, 0, 0, 0.2);
        width: 200px;
        border-radius: 5px;
        color: #131313;
    }

    .selected span {
        cursor: pointer;
        display: flex;
        padding: 10px 15px;
        margin: 0;
    }

    @media(min-width:1024px) {
        .drop-content {
            position: relative;
        }

        .drop-content ul {
            position: absolute;
            /* left: 0px; */
            top: -15px;
            display: none;
            list-style: none;
            width: 300px;
            background: white;
            border-top: 0;
            border: 1px solid lightgray;
            border-radius: 0 0 5px 5px;
            padding-top: 13px;
            top: 29%;
            right: 0;
        }
    }

    @media(min-width:555px) and (max-width:1024px) {
        .drop-content {
            position: relative;
        }

        .drop-content ul {
            position: absolute;
            top: -15px;
            display: none;
            list-style: none;
            width: 300px;
            background: white;
            border-top: 0;
            border: 1px solid lightgray;
            border-radius: 0 0 5px 5px;
            padding-top: 13px;
            top: 29%;
            right: -42px;
        }
    }

    .drop-content ul li span {
        display: flex;
        padding: 10px 15px;
        text-decoration: none;
        color: #131313;
    }

    .drop-content ul li {
        padding-left: 0px !important;
    }

    .drop-label-1 {
        line-height: normal;
        /* color: #222; */
        font-size: 14px !important;
        font-weight: 600;
        line-height: 23px;
        text-decoration: none;
        /* text-transform: uppercase; */
        cursor: pointer;
    }

    .drop-label-2 {
        font-size: 13px;
        font-weight: 400;
        cursor: pointer;
    }

    .dropdown-a:hover {
        text-decoration: none;
        color: var(--theme-color);
        cursor: pointer;
    }

    .dropdown-a:hover .svg-address path,
    .dropdown-a:hover .svg-logout path {
        fill: var(--theme-color);
    }

    .dropdown-a:hover .svg-user path {
        stroke: var(--theme-color);
    }

    .drop-content ul li {
        transform: translate(8px, 0);
        transition: transform 150ms cubic-bezier(.39, .575, .565, 1);
    }

    .drop-content ul li:hover {
        transform: scale(1);
        transform-origin: 50% 0%;
    }

    .auth-sign-ul li {
        padding: 10px;
    }

    .searchResult {
        background: #fff;
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
        overflow-y: scroll;
        max-height: 425px;
        width: 32.9%;
        position: fixed;
        z-index: 9;
    }

    .searchResult a li {
        padding: 8px;
        border-bottom: 1px solid #353535;
        width: 100%;
    }

    .searchResult a li span {
        color: var(--theme-color);
    }

    .searchResult a:hover {
        color: #000;
    }

    @media (min-width:250px) and (max-width:555px) {
        .drop-content {
            right: -30rem;
        }

        .searchResult {
            width: 95%;
        }

        .drop-content .auth-sign-ul {
            position: fixed !important;
            display: none;
            list-style: none;
            width: 300px;
            background: white;
            border-top: 0;
            border: 1px solid lightgray;
            border-radius: 0 0 5px 5px;
            padding-top: 13px;
            right: 0rem;
        }
    }
</style>
<script>
    $(document).ready(function() {
        $(".fi-rr-user").on('click', function() {
            $('#authSign').css('display', 'block !important');
            $(".dropdown_click .drop-content ul").slideToggle();
        });


        
    });
</script>

        
