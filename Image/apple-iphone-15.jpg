    // scroll to shrink nav bar
    window.onscroll = function () {
        scrollFunction()
    };
    var window_width = $(window).width();


    function scrollFunction() {
        if (document.documentElement.scrollTop > 80) {
            if ((window_width > 767) && (window_width < 1024)) {
                $('.header').css('background-color', '#d72828');
                // $('.onhover-div').css('padding','20px 0px 20px 0px');
                //$('.onhover-div').css('padding', '40px 0px 40px 20px');

                $('.menu-left').css('width', '60px');
                // $('.cart_qty_cls').css('top','2%').css('right','-9px');
                $('.cart-i').css('color', '#fff');
                $('#auth-btn').css('color', '#fff');
                $('.navbar i').css('color', '#fff');
                $('.ti-mobile').css('color', '#fff');
                $('.mobile-span').css('color', '#fff');

            } else {
                //$('.onhover-div').css('padding', '40px 0px 40px 20px');
                $('.menu-left').css('width', '60px');
                // $('.cart_qty_cls').css('top','2%').css('right','-9px');

            }
            // document.getElementsByClassName("onhover-div").style.padding = "30px 0px 30px 0px";
            // document.getElementsByClassName("logo").style.fontSize = "25px";
        }
        if (document.documentElement.scrollTop < 70) {
            if ((window_width > 767) && (window_width < 1024)) {
                $('.cart-i').css('color', 'black');
                $('#auth-btn').css('color', 'black');
                $('.navbar i').css('color', 'black');
                $('.ti-mobile').css('color', 'black');
                $('.mobile-span').css('color', 'black');
            }
        }
        if (document.documentElement.scrollTop > 70) {

        }
        if (document.documentElement.scrollTop < 20) {
            $('.header').css('background-color', '#fff');
            // $('.onhover-div').css('padding','40px 0px 40px 0px');
            //$('.onhover-div').css('padding', '40px 0px 40px 20px');
            $('.menu-left').css('width', '60px');
            // $('.cart_qty_cls').css('top','20%').css('right','-8px');
            // document.getElementsByClassName("onhover-div").style.padding = "40px 0px 40px 0px";
            // document.getElementsByClassName("logo").style.fontSize = "35px";
        }
    }


    function getStoreStock(itemCode){
    var item = $(itemCode).data('id');
    //console.log(item);
    $("#storeStockTable tbody").empty();
    $("#storeStockTable1 tbody").empty();
    if(!usn){
        var usn = 'T Nagar';
    }else{
        var usn = localStorage.getItem('userStoreName');
        var usn = usn.replace(/\"/g, "");
    }
    
    var store_name = usn;
    $.ajax({ 
            type: 'get', 
            url: '/item_search', 
		    dataType: "json",
            data: 'item=' + item + '&store_name=' + store_name + '&_token=PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f', 
            success: function (data) {
                console.log(data);
                var stores_html = '';
                for(var my_i=0;my_i<data['stores'].length;my_i++)
                {
                    stores_html += "<tr><td>"+data['stores'][my_i]['title']+"</td><td>"+data['stores'][my_i]['quantity']+"</td></tr>";
                }
                $('#storeStockTable tbody').html(stores_html);
                
                var warehouse_html = '';
                for(var my_j=0;my_j<data['warehouse'].length;my_j++)
                {
                    warehouse_html += "<tr><td>"+data['warehouse'][my_j]['title']+"</td><td>"+data['warehouse'][my_j]['quantity']+"</td></tr>";
                }
                $('#storeStockTable1 tbody').html(warehouse_html);
                
                $('#stockModal').modal('show');

            }
        });   
    }
    function generate_pdf_file()
    {
        var href_url = $("#pdf-export-url").attr("url-href");
        $("#pdf-generate-div").addClass("d-none");
        $("#pdf-spinner-div").removeClass("d-none");
        
        $.ajax({
            url:"https://www.sathya.store/"+href_url,
            method:"GET",
            success:function(data){
                if(data.status == 1)
                {
                    var pdf_url = "https://www.sathya.store/php-excel-export/"+data.file_name;
                    $("#pdf-download-btn").attr("href", pdf_url);                        
                    $("#pdf-spinner-div").addClass("d-none");
                    $("#pdf-download-div").removeClass("d-none");
                }
            },
            error: function(code) {		
                alert(code.statusText);
            },
        });
    }
</script>



<script>


       


        //sub-category position
function updateSubCategoryPosition() {
    //const offer = document.querySelector('.offer-div');
    const navbar = document.querySelector('.header-navbar');

    //navbar.style.top = offer.offsetHeight + "px";

    const header = document.querySelector('header');

    header.style.height = /*offer.offsetHeight +*/ navbar.offsetHeight + "px";

    //const offerHeight = offer ? offer.offsetHeight : 0;
    const navbarHeight = navbar ? navbar.offsetHeight : 0;

    const totalHeight = /*offerHeight + */navbarHeight;

    // Apply dynamic top position for all sub-category menus
    document.querySelectorAll('.sub-category').forEach(menu => {
        menu.style.top = totalHeight + "px";
    });
}

function updatesubcategoryscrollpos(){
  const navbar = document.querySelector('.header-navbar');

  const totalHeight = navbar.offsetHeight;

  document.querySelectorAll('.sub-category').forEach(menu => {
      menu.style.top = totalHeight + "px";
  });
}
    
    
// Run on load
updateSubCategoryPosition();

// Run on resize (important for responsive)
