                    checkSchemas('IP15128BLUMTP43');
                function checkSchemas(pid) {
            var data = {
                'pid': pid,
                '_token': 'PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f'
            };

            console.log(data);
            $.ajax({
                type: "POST",
                url: '/apis/schemasFetch_generate',
                data: data

            }).done(function(result) {

                var json1 = JSON.parse(result);
                if(json1.responseErrorCode == "00")
                {
                    var schemaData = json1.result.records;
                    if(schemaData.length>=1)
                    {
                        var html_text = '';

                        html_text += '<div class="panel-group" id="accordion">';
                        var a_no = 0;
                        schemaData.forEach(function(d) {
                            var value=d.tenor;
                            // console.log(value.toString().length); 
                            a_no++;
                            var grsAmt = '59900.0000' - d.advEmiAmt;
                            
                            html_text += `<div class="panel panel-default">
                                            <div class="panel-heading" style="display:flex;">
                                                <h4 class="panel-title" style="${value.toString().length == 1 ?'margin-right:17px;':'margin-right:10px;'} ">
                                                <a data-toggle="collapse" data-parent="#accordion" href="#collapse`+a_no+`"><i class="fa fa-chevron-circle-right" aria-hidden="true"></i>
                                                    ₹`+d.emiAmount+`.00 per Month - `+d.tenor+`m</a>
                                                </h4>
                                                <h4><b class="pull-right" style="${d.downPayment == 0 ?'color:red;':''}">Down Payment ₹`+ d.downPayment +`.00</b></h4>
                                            </div>
                                            <div id="collapse`+a_no+`" class="panel-collapse collapse in">
                                                <div class="panel-body d-flex">
                                                    <table class="table table-bordered">
                                                        <tr>
                                                            <th>Advance Emi Amount</th>
                                                            <th><b class="pull-right">₹`+ d.advEmiAmt +`.00</b></th>
                                                        </tr>
                                                        <tr>
                                                            <th>Processing Fee</th>
                                                            <th><b class="pull-right">₹`+ d.processingFee +`.00</b></th>
                                                        </tr>
                                                        <tr>
                                                            <th>Loan Amount</th>
                                                            <th><b class="pull-right">₹`+ grsAmt +`.00</b></th>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>`;
                                

                        });
                        html_text += '</div>';
                        $(".bajaj_emi_options_body").html(html_text);
                        $("#bajaj_emi_options").show();
                    }
                    else
                    {
                        $("#bajaj_emi_options").hide();
                    }
                }
                else
                {
                    $("#bajaj_emi_options").hide();
                }              
            });
        }


        function review_details_each_product(reviewid) {
            // alert(reviewid);

            $.ajax({
                type: 'post',
                url: '/ajaj_get_review_details',
                data: {
                    reviewid: reviewid,
                    _token: 'PVkPLPYaYQnGVgq7AVhJLcwK4xUsoXvSeQas7Q5f'
                },
                success: function(data) {
                    $("#ajax_review_det_modal").html(data);
                    $("#reviewDetailModal").modal('show');
                }

            });
        }
    </script>
