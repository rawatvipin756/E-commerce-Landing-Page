document.querySelectorAll('.text-area').forEach(textArea => {

    const items = Array.from(textArea.children);
    const MAX_ITEMS = 12;

    let column = document.createElement('div');
    column.classList.add('column');
    let count = 0;

    // Remove original children
    items.forEach(el => textArea.removeChild(el));

    // Create columns
    items.forEach((el, index) => {

        column.appendChild(el);
        count++;

        if (count === MAX_ITEMS || index === items.length - 1) {
            textArea.appendChild(column);

            // Start a new column
            column = document.createElement('div');
            column.classList.add('column');
            count = 0;
        }

    });

});

//category-hover
document.querySelectorAll('.main-category').forEach(category => {

    const sub = category.querySelector('.sub-category');

    category.addEventListener('mouseenter', () => {

        sub.classList.add('show'); // show dropdown to measure width

        const catRect = category.getBoundingClientRect();  
        const subRect = sub.getBoundingClientRect();       
        const viewportWidth = window.innerWidth;
        const tolarence = 10;

        let leftPos = catRect.left;  // default: align under category

        // RIGHT OVERFLOW FIX
        if (leftPos + subRect.width >= viewportWidth-tolarence) {
            leftPos = viewportWidth - subRect.width - 20; // shift left
        }

        // LEFT OVERFLOW FIX
        if (leftPos < 10) {
            leftPos = 10;
        }

        // APPLY POSITION
        sub.style.left = leftPos + "px";
        sub.style.top = (catRect.bottom + 0) + "px";
    });

    // Hide when leaving
    category.addEventListener('mouseleave', () => {
        sub.classList.remove('show');
    });
});


//carousel-section
function initCarouselSection(section) {

  const menutitlecard = section.querySelectorAll('.menu-title-card');
  const currenttittle = section.querySelector('.current-menu-title');
  const swipers = [];
  const isbanneredmenu = section.classList.contains("banner-carousel-swiper");

  // initialize all swipers inside section
  section.querySelectorAll('.swiper').forEach(swiperEl => {
    swipers.push(new Swiper(swiperEl, {
      slidesPerView: isbanneredmenu ? 3 : 4,
      spaceBetween: 15,
      breakpoints: {
        1200: { slidesPerView: isbanneredmenu ? 4 : 4 },
        992: { slidesPerView: 3 },
        768: { slidesPerView: 2 },
        576: { slidesPerView: 2 },
        0: { slidesPerView: 1 }
      }
    }));
  });

  // Active swiper index
  let activeIndex = 0;

  // Tab click behavior
  menutitlecard.forEach((tab, index) => {
    tab.addEventListener('click', () => {

      const categoryId = tab.getAttribute("menu-title-id");
      if(currenttittle){
        currenttittle.textContent = tab.textContent;
      }

      const viewAllUrl = tab.getAttribute("data-view-all");
      // update View All link
    const viewAllLink = section.querySelector('#viewAllLink');
    if (viewAllLink && viewAllUrl) {
      viewAllLink.href = viewAllUrl;
    }

      menutitlecard.forEach(t => t.classList.remove("selected-menu-title"));
      tab.classList.add("selected-menu-title");

      section.querySelectorAll('.swiper').forEach((sw, i) => {
        const wrapper = sw.querySelector('.swiper-wrapper');
        const id = wrapper.getAttribute('data-category-menu-id');

        if (id === categoryId) {
          sw.style.display = "block";
          sw.style.padding = '10px';
          activeIndex = i;
          sw.querySelectorAll('.category-menu-products-row').forEach(row => row.classList.remove('selected-menu'));
          wrapper.classList.add('selected-menu');
          swipers[i].update();
          swipers[i].slideTo(0);
        } else {
          sw.style.display = "none";
          sw.style.padding = '0px';
        }
      });

    });
  });

  // Navigation button controls only active swiper
  section.querySelector('.menu-item-control-next')
    .addEventListener('click', () => swipers[activeIndex].slideNext());

  section.querySelector('.menu-item-control-prev')
    .addEventListener('click', () => swipers[activeIndex].slidePrev());

}

// initialize all carousel sections
document.querySelectorAll('.carousel-section').forEach(initCarouselSection);


//star-dynamic-rating
function renderRatings() {
  document.querySelectorAll('.rating').forEach(ratingEl => {
    const ratingValue = Number(ratingEl.dataset.rating);
    ratingEl.innerHTML = ''; // Clear previous stars

    for (let i = 1; i <= 5; i++) {
      const star = document.createElement('span');
      star.textContent = '★';

      if (i <= ratingValue) {
        star.classList.add('filled');
      }

      ratingEl.appendChild(star);
    }
  });
}

renderRatings();

