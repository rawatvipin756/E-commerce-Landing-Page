    <script type="text/javascript">
     $(function(){
            $(".bajaj-quantity-error").hide();
        });
        $(".refresh-cpatcha").click(function() {
            $.ajax({
                type: 'GET',
                url: "https://www.sathya.store/refresh-captcha",
                success: function(data)
                {
                    $(".captcha span").html(data);
                }
            });
        });
        $(document).ready(function(){
                    });
        function share_review_page()
        {
            var url = window.location.href;
            url = url.replace("#top-tab","");
            url = url.replace("?share=review","");
            url = url+"?share=review";
             // Copy the text inside the text field
            navigator.clipboard.writeText(url.toString());
            
            // alertify.notify("<i class='fa fa-check'></i> URL Copied", "success");
            
                        Toast.fire({
                        icon: "success",
                        title: "URL Copied"
                        });
            
            // Select the text field
            url.select();
            url.setSelectionRange(0, 99999); // For mobile devices
        }
        function open_review_model()
        {
            $("#exampleModalCenter").modal("show");
        }
        function show_delivery_by_div()
        {
            $("#delivery-by-div").hide();

            var str = $("#delivery-input").val();
            if(str ==''){
                $("#delivery-by-message").html("Enter Valid PIN Code");
                $("#delivery-by-message").removeClass("text-success");
                $("#delivery-by-message").addClass("text-danger");
                $("#delivery-by-div").show();
                return false;
            }
            let regex = new RegExp(/^[1-9]{1}[0-9]{2}\s{0,1}[0-9]{3}$/);
            if (regex.test(str) == true) {                

                $.ajax({
                    url:"/check-delivery-pincode",
                    data:{pincode:str},
                    method:"GET",
                    dataType: "json",
                    success:function(response){
                        // alert(response);
                        $("#delivery-by-message").html(response.message);
                        if(response.status)
                        {
                            $("#delivery-by-message").removeClass("text-danger");
                            $("#delivery-by-message").addClass("text-success");
                        }
                        else
                        {
                            $("#delivery-by-message").removeClass("text-success");
                            $("#delivery-by-message").addClass("text-danger");
                        }
                        $("#delivery-by-div").show("fast");
                    },
                    error: function(code) {		
                        alert(code.statusText);
                    },
                });
            }
            else {
                $("#delivery-by-message").html("Enter Valid PIN Code");
                $("#delivery-by-message").removeClass("text-success");
                $("#delivery-by-message").addClass("text-danger");
                $("#delivery-by-div").show();
            }


            // if(($("#delivery-input").val().length == 6 && event != 'Enter') || ($("#delivery-input").val().length == 6 && event.key=='Enter') )
            // {
            //     $("#delivery-error-div").hide();
            //     $("#delivery-by-div").show("fast");
            // }
            // else{                                    
            //     $("#delivery-by-div").hide();
            //     $("#delivery-error-div").show();
            // }
        }
    </script>
