        background: #d72727;
        color: white;
        max-width: 300px;
        width: 100%;
        padding: 10px;
        font-size: 17px;
        border-radius: 8px;
    }

    .otp-label {
        font-size: 18px !important;
        font-weight: 700;
    }

    input.option-input {
        border-radius: 10%;
        -webkit-border-radius: 10%;
        -moz-border-radius: 10%;
        -ms-border-radius: 10%;
        -o-border-radius: 10%;
    }

    .option-input {
        -webkit-appearance: none;
        -moz-appearance: none;
        -ms-appearance: none;
        -o-appearance: none;
        appearance: none;
        position: relative;
        top: 7px;
        right: 0;
        bottom: 0;
        left: 0;
        height: 25px;
        width: 25px;
        color: #fff;
        cursor: pointer;
        display: inline-block;
        margin-right: 0.5rem;
        outline: none;
        position: relative;
        z-index: 10;
        background: #FFFFFF;
        border: 1.42283px solid #D1DAE6;
        box-sizing: border-box;
        box-shadow: 0px 2.84566px 5.69132px -2.84566px rgba(0, 28, 63, 0.21);
        border-radius: 7.11415px;
    }

    .option-input:hover {
        background: #F1F2FE;
    }

    .option-input {
        margin-top: -15px;
        background: #FFFFFF;
        border: 1.42283px solid #D1DAE6;
        box-sizing: border-box;
        border-radius: 7.11415px;
