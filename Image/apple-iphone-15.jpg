    <script type="text/javascript">
        const usePayuAffordabilityWidget = false;
        
        const payuKey = "raoFU2";
        const payuAmount = "59900.00";
        const payuSkuDetails = [{"skuId":"IP15128BLUMTP43","skuAmount":"59900.00","quantity":"1"}];
        const key = "rzp_live_KrAP9KEDGHrelP";
        const amount = 5990000;

        //const amount = 59900.0000;

        window.addEventListener('load', function() {
            if (usePayuAffordabilityWidget) {
                if (!payuKey || typeof payuAffordability === 'undefined') {
                    return;
                }

                const widgetConfig = {
                    "key": payuKey,
                    "amount": payuAmount,
                    "skusDetail": payuSkuDetails,
                    "container": "#payuWidget",
                    "styleConfig": {
                        "lightColor": "#FFF4F4",
                        "darkColor": "#D71920",
                        "backgroundColor": "#FFFFFF"
                    }
                };

                payuAffordability.init(widgetConfig);
                return;
            }

            if (typeof RazorpayAffordabilitySuite === 'undefined') {
                return;
            }

            const widgetConfig = {
                "key": key,
                "amount": amount,
                "features": {"offers":{"list":[]}}            };
            const rzpAffordabilitySuite = new RazorpayAffordabilitySuite(widgetConfig);
            rzpAffordabilitySuite.render();
        });
    </script>

